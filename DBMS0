CREATE DATABASE CompanyDB;
USE CompanyDB;

CREATE TABLE Employee (
    E_id INT PRIMARY KEY,
    E_name VARCHAR(100),
    Age INT,
    Salary DECIMAL(10,2)
);

SELECT COUNT(E_name) AS NumberOfEmployees
FROM Employee;

SELECT MAX(Age) AS MaxAge
FROM Employee;

SELECT MIN(Age) AS MinAge
FROM Employee;

SELECT Salary
FROM Employee
ORDER BY Salary ASC;

SELECT Salary, COUNT(*) AS NumberOfEmployees
FROM Employee
GROUP BY Salary;

